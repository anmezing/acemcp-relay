# Copy to nginx.env, edit for the target host, then run ./render-nginx-config.sh.
PUBLIC_SERVER_NAMES="console.example.com www.console.example.com"
PRIMARY_PUBLIC_HOST=console.example.com
TLS_CERTIFICATE_PATH=/etc/ssl/example/origin.pem
TLS_CERTIFICATE_KEY_PATH=/etc/ssl/example/origin.key
NGINX_LISTEN_BACKLOG=8192
NGINX_CLIENT_MAX_BODY_SIZE=100m
NGINX_MCP_CLIENT_MAX_BODY_SIZE=32m
NGINX_MCP_UPSTREAM=http://127.0.0.1:3009
NGINX_FRONTEND_UPSTREAM=http://127.0.0.1:3001
NGINX_MCP_PROXY_TIMEOUT=360s
NGINX_FRONTEND_PROXY_TIMEOUT=3600s
