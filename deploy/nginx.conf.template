server {
    listen 80;
    listen [::]:80;

    server_name ${PUBLIC_SERVER_NAMES};

    return 301 https://${PRIMARY_PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl backlog=${NGINX_LISTEN_BACKLOG};
    listen [::]:443 ssl backlog=${NGINX_LISTEN_BACKLOG};

    server_name ${PUBLIC_SERVER_NAMES};

    ssl_certificate ${TLS_CERTIFICATE_PATH};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY_PATH};

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # MCP endpoint → relay
    location /mcp {
        proxy_pass ${NGINX_MCP_UPSTREAM};
        proxy_http_version 1.1;
        client_max_body_size ${NGINX_MCP_CLIENT_MAX_BODY_SIZE};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;

        proxy_read_timeout ${NGINX_MCP_PROXY_TIMEOUT};
        proxy_send_timeout ${NGINX_MCP_PROXY_TIMEOUT};
    }

    # Frontend API
    location /api {
        proxy_pass ${NGINX_FRONTEND_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout ${NGINX_FRONTEND_PROXY_TIMEOUT};
        proxy_send_timeout ${NGINX_FRONTEND_PROXY_TIMEOUT};
    }

    # Frontend pages
    location / {
        proxy_pass ${NGINX_FRONTEND_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout ${NGINX_FRONTEND_PROXY_TIMEOUT};
        proxy_send_timeout ${NGINX_FRONTEND_PROXY_TIMEOUT};
    }
}
