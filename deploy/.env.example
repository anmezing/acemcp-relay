# ── PostgreSQL (Docker 容器内) ──
POSTGRES_USER=acemcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acemcp_relay

# ── LCE Cloud Database (pgvector) ──
LCE_CLOUD_DATABASE_URL=postgresql://acemcp:change-me@host.docker.internal:5432/acemcp_relay

# ── LCE Embedding/Rerank Providers ──
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDINGS_API_KEY=
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=

# ── Better Auth (frontend) ──
BETTER_AUTH_URL=https://lcebot.com
BETTER_AUTH_SECRET=change-me-random-string

# ── OAuth Providers ──
AUTH_LINUXDO_ID=
AUTH_LINUXDO_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# ── 租户断言（relay <-> LCE，必填）──
# relay 签发、LCE 校验，两端必须一致，>=32 字符。
# 生成：openssl rand -base64 48
LCE_TENANT_ASSERTION_SECRET=

# ── 用户自定义 Rerank 加密（可选）──
# AES-256-GCM 加密用户 API key，前端与 relay 必须一致。
# 留空则关闭用户自定义 rerank。
# 生成：openssl rand -base64 48
MODEL_CONFIG_SECRET=

# ── 管理控制台 ──
ADMIN_EMAILS=

# ── 配额 ──
DEFAULT_DAILY_REQUEST_LIMIT=0
DAILY_INDEX_BYTES_LIMIT=2147483648

# ── Cloud 客户端版本控制（可选）──
# 客户端经 npm 分发（@anmezing/lce-cloud），版本号即包版本。
# 低于 MIN 的客户端被拒绝 (426)；低于 LATEST 的收到升级提示（升级 = npx 自动拉新版）
MIN_CLIENT_VERSION=
LATEST_CLIENT_VERSION=1.2.0

# ── TLS ──
SSL_CERT_PATH=./certs

# ── 分层配额（可选；0 = 不限）──
PRO_DAILY_REQUEST_LIMIT=0
PRO_DAILY_INDEX_BYTES_LIMIT=0

# ── 套餐支付（可选；渠道参数不完整时前端禁用该渠道）──
# 必须是支付宝/微信服务器可访问的公网 HTTPS origin。
PAYMENT_NOTIFY_BASE_URL=https://lcebot.com

# 支付宝当面付
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_SELLER_ID=
ALIPAY_ENDPOINT=

# 微信支付 API v3 Native
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
# 微信支付公钥模式的公钥 ID（PUB_KEY_ID_...），不是商户证书序列号。
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com

# ── 指标（可选；非空时在主端口开放 GET /metrics，Bearer 鉴权）──
METRICS_TOKEN=
