# ── PostgreSQL (Docker 容器内) ──
POSTGRES_USER=acemcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acemcp_relay

# ── LCE Embedding/Rerank Providers ──
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDINGS_API_KEY=
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=

# ── Better Auth (frontend) ──
BETTER_AUTH_URL=https://513689.xyz
BETTER_AUTH_SECRET=change-me-random-string

# ── OAuth Providers ──
AUTH_LINUXDO_ID=
AUTH_LINUXDO_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# ── 租户断言（relay <-> LCE，必填）──
# relay 签发、LCE 校验，两端必须一致，>=32 字符。
# 生成：openssl rand -base64 48
LCE_TENANT_ASSERTION_SECRET=

# ── 用户自定义 Rerank 加密（可选）──
# AES-256-GCM 加密用户 API key，前端与 relay 必须一致。
# 留空则关闭用户自定义 rerank。
# 生成：openssl rand -base64 48
MODEL_CONFIG_SECRET=

# ── 管理控制台 ──
ADMIN_EMAILS=

# ── 配额 ──
DEFAULT_DAILY_REQUEST_LIMIT=0
DAILY_INDEX_BYTES_LIMIT=2147483648

# ── 设备绑定 ──
DEVICE_BINDING_MODE=log
MAX_DEVICES_PER_USER=1
DEVICE_MAX_IPS=3
DEVICE_IP_WINDOW=10m
DEVICE_CACHE_TTL=5m
API_KEY_CACHE_TTL=30m

# ── TLS ──
SSL_CERT_PATH=./certs
# HTTP_PORT=80
# HTTPS_PORT=443
