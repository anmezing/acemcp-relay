PLATFORM_MODEL_CONFIG_SAVE_TIMEOUT=15s
PLATFORM_MODEL_CONFIG_RESET_SAVE_TIMEOUT=60s
PLATFORM_MODEL_CONFIG_LOCK_POLL_INTERVAL=50ms
LEADERBOARD_UPDATE_INTERVAL=30m
LEADERBOARD_TOP_N=10
LEADERBOARD_TIMEZONE=Asia/Shanghai
HEALTH_CHECK_INTERVAL=2m
HEALTH_CHECK_TIMEOUT=30s
MCP_HTTP_IDLE_CONN_TIMEOUT=90s
MCP_HTTP_MAX_IDLE_CONNS=50
MCP_HTTP_MAX_IDLE_CONNS_PER_HOST=50
MCP_SESSION_TTL=30m
MCP_SESSION_SWEEP_INTERVAL=1m
MCP_TOOLS_CACHE_TTL=5m
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=40
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
AUTH_CACHE_POSITIVE_TTL=30s
AUTH_CACHE_NEGATIVE_TTL=5s
AUTH_CACHE_MAX_ENTRIES=10000
MODEL_CONFIG_CACHE_TTL=5m
QUOTA_CACHE_TTL=5m
QUOTA_COUNTER_TTL=48h
REQUEST_LOG_STALE_AFTER=15m
REQUEST_LOG_RECONCILE_INTERVAL=5m
CLEAR_INDEX_COOLDOWN=72h
DELETE_ROOT_MIN_INTERVAL=1m
DELETE_ROOT_MEMORY_ENTRIES=4096
INDEX_OPERATION_LEASE_DURATION=2m
INDEX_OPERATION_RENEW_INTERVAL=30s
INDEX_OPERATION_ACQUIRE_POLL_INTERVAL=100ms
INDEX_OPERATION_DB_TIMEOUT=5s
# Optional deployment capability. Configure a package runner and/or a global executable;
# when neither is set, the console stays available but disables client-config copying.
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_RUNNER=
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_RUNNER_ARGS=[]
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_NAME=@anmezing/lce-cloud
NEXT_PUBLIC_LCE_CLIENT_PACKAGE_TAG=latest
NEXT_PUBLIC_LCE_CLIENT_GLOBAL_EXECUTABLE=
NEXT_PUBLIC_APPLICATION_TIMEZONE=
APPLICATION_TIMEZONE=Asia/Shanghai
NEXT_PUBLIC_INDEX_POLL_ACTIVE_MS=5000
NEXT_PUBLIC_INDEX_POLL_IDLE_MS=30000
NEXT_PUBLIC_LOGS_AUTO_REFRESH_MS=5000
NEXT_PUBLIC_LOGS_PAGE_SIZE=20
NEXT_PUBLIC_LEADERBOARD_REFRESH_MS=30000
NEXT_PUBLIC_LEADERBOARD_DATE_OPTION_COUNT=3
NEXT_PUBLIC_PAYMENT_STATUS_POLL_MS=2000
