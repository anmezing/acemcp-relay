# ── PostgreSQL (Docker 容器内) ──
POSTGRES_USER=acemcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acemcp_relay

# ── LCE Cloud Database (pgvector) ──
LCE_CLOUD_DATABASE_URL=postgresql://acemcp:change-me@host.docker.internal:5432/acemcp_relay

# ── LCE Embedding/Rerank Providers ──
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDINGS_API_KEY=
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=

# ── Better Auth (frontend) ──
BETTER_AUTH_URL=https://console.example.com
# Optional when it is identical to BETTER_AUTH_URL; Compose inherits that origin.
NEXT_PUBLIC_SITE_URL=
BETTER_AUTH_SECRET=change-me-random-string
# Cloudflare (or other edge proxy) IPs/CIDRs allowed to supply X-Forwarded-For.
# Leave empty to ignore forwarded client IPs and use a shared Better Auth rate-limit bucket.
BETTER_AUTH_TRUSTED_PROXIES=

# ── OAuth Providers ──
AUTH_LINUXDO_ID=
AUTH_LINUXDO_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# 邮箱注册验证（启用邮箱注册前必须配置可用 SMTP）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ── 租户断言（relay <-> LCE，必填）──
# relay 签发、LCE 校验，两端必须一致，>=32 字符。
# 生成：openssl rand -base64 48
LCE_TENANT_ASSERTION_SECRET=

# ── 用户自定义 Rerank 加密（可选）──
# AES-256-GCM 加密用户 API key，前端与 relay 必须一致。
# 留空则关闭用户自定义 rerank。
# 生成：openssl rand -base64 48
MODEL_CONFIG_SECRET=

# ── 管理控制台 ──
ADMIN_EMAILS=

# ── 配额 ──
DEFAULT_DAILY_REQUEST_LIMIT=0
DAILY_INDEX_BYTES_LIMIT=2147483648

# ── Cloud 客户端版本控制 ──
# 当前发布版本由控制台从 npm dist-tag latest 自动读取，不在部署文件中写死。
# MIN 是数据库尚无管理员配置时的启动默认值；配置后由系统设置页面持久化并立即生效。
MIN_CLIENT_VERSION=

# ── TLS ──
SSL_CERT_PATH=./certs

# ── 分层配额（可选；0 = 不限）──
PRO_DAILY_REQUEST_LIMIT=0
PRO_DAILY_INDEX_BYTES_LIMIT=0

# ── 套餐支付（可选；渠道参数不完整时前端禁用该渠道）──
# 必须是支付宝/微信服务器可访问的公网 HTTPS origin。
PAYMENT_NOTIFY_BASE_URL=https://console.example.com

# 支付宝当面付
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_SELLER_ID=
ALIPAY_ENDPOINT=

# 微信支付 API v3 Native
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
# 微信支付公钥模式的公钥 ID（PUB_KEY_ID_...），不是商户证书序列号。
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com

# ── 指标（可选；非空时在主端口开放 GET /metrics，Bearer 鉴权）──
METRICS_TOKEN=

# ── Advanced runtime and deployment policy ──
RELAY_HOST_BIND_ADDRESS=127.0.0.1
RELAY_HOST_PORT=3009
RELAY_CONTAINER_LISTEN_ADDR=0.0.0.0:3009
RELAY_LCE_MCP_URL=http://lce:3000/mcp
FRONTEND_HOST_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=3001
PPROF_ADDR=127.0.0.1:6060
# docker-compose.yml also has validated startup defaults; listing every knob here
# makes deployment policy discoverable without editing application source files.
LCE_PROVIDER_AUTH_COOLDOWN_MS=300000
LCE_PROVIDER_BILLING_COOLDOWN_MS=900000
LCE_PROVIDER_TRANSIENT_COOLDOWN_MS=5000
LCE_PROVIDER_RATE_LIMIT_MIN_COOLDOWN_MS=1000
EMBEDDINGS_API_KEYS=
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_OUTPUT_DIMENSION=
EMBEDDINGS_OUTPUT_DTYPE=
EMBEDDINGS_NETWORK_MAX_RETRIES=3
EMBEDDINGS_RATE_LIMIT_MAX_RETRIES=5
EMBEDDINGS_RETRY_INITIAL_DELAY_MS=1000
EMBEDDINGS_RATE_LIMIT_MIN_BACKOFF_MS=5000
EMBEDDINGS_RATE_LIMIT_MAX_BACKOFF_MS=60000
EMBEDDINGS_RATE_LIMIT_SUCCESS_INCREASE_COUNT=3
EMBEDDINGS_RATE_LIMIT_BACKOFF_DECAY_SUCCESSES=10
EMBEDDINGS_RATE_LIMIT_SLOT_POLL_MS=50
RERANK_API_KEYS=
RERANK_MAX_ATTEMPTS=3
RERANK_RETRY_MAX_DELAY_MS=10000
RERANK_RATE_LIMIT_RETRY_BASE_MS=1000
RERANK_TRANSIENT_RETRY_BASE_MS=500
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_BASE_URL=
QUERY_REWRITE_MODEL=
QUERY_REWRITE_MAX_QUERIES=3
QUERY_REWRITE_TIMEOUT_MS=4000
QUERY_REWRITE_CACHE_MAX_ENTRIES=256
PROMPT_ENHANCER_ENABLED=false
PROMPT_ENHANCER_PROVIDER=openai-compatible
PROMPT_ENHANCER_MODEL=
PROMPT_ENHANCER_BASE_URL=
PROMPT_ENHANCER_API_KEY=
PROMPT_ENHANCER_API_KEYS=
PROMPT_ENHANCER_TIMEOUT_MS=30000
PROMPT_ENHANCER_MAX_CONCURRENT_REQUESTS=4
PROMPT_ENHANCER_MAX_RESPONSE_BYTES=524288
PROMPT_ENHANCER_MAX_OUTPUT_TOKENS=1200
PROMPT_ENHANCER_MAX_ATTEMPTS_PER_KEY=2
PROMPT_ENHANCER_RETRY_MIN_DELAY_MS=250
PROMPT_ENHANCER_RETRY_DEFAULT_DELAY_MS=500
PROMPT_ENHANCER_RETRY_MAX_DELAY_MS=2000
LCE_HTTP_MAX_CONCURRENT_REQUESTS=16
LCE_HTTP_MAX_SESSIONS=16
LCE_CLOUD_DB_POOL_MAX=16
LCE_CLOUD_DB_QUERY_POOL_MAX=
LCE_PLATFORM_MODEL_CONFIG_VALIDATION_TIMEOUT_MS=30000
LCE_PLATFORM_MODEL_CONFIG_LOCK_TIMEOUT_MS=10000
LCE_PLATFORM_MODEL_CONFIG_STATEMENT_TIMEOUT_MS=50000
LCE_PLATFORM_MODEL_VALIDATION_TICKET_TTL_MS=600000
LCE_PLATFORM_MODEL_PROVIDER_RESPONSE_MAX_BYTES=1048576
LCE_PLATFORM_MODEL_DISCOVERY_TIMEOUT_MS=10000
LCE_PLATFORM_MODEL_DISCOVERY_RESULT_LIMIT=500
LCE_CLOUD_INDEX_JOB_TTL_MINUTES=15
LCE_CLOUD_COMPILER_SNAPSHOT_MAX_FILES=2000
LCE_CLOUD_QUERY_EMBEDDING_CACHE_TTL_MS=30000
LCE_CLOUD_QUERY_EMBEDDING_CACHE_MAX_ENTRIES=512
LCE_CLOUD_RERANK_CACHE_TTL_MS=30000
LCE_CLOUD_RERANK_CACHE_MAX_ENTRIES=512
TRUSTED_PROXIES=
BANNED_CACHE_TTL=5m
MCP_MAX_SESSIONS=1000
MCP_MAX_SESSIONS_PER_USER=16
INDEX_JOB_HEARTBEAT_TIMEOUT=10m
INDEX_JOB_SWEEP_INTERVAL=1m
INDEX_JOB_RENEW_TIMEOUT=15s
INDEX_MAX_MANIFEST_FILES=100000
INDEX_MAX_BATCH_FILES=50
INDEX_MAX_FILE_BYTES=524288
INDEX_MAX_BATCH_BYTES=524288
INDEX_MAX_PATH_BYTES=4096
INDEX_MAX_FAILURE_BYTES=2000
INDEX_START_MIN_INTERVAL=30s
INDEX_START_MEMORY_ENTRIES=4096
MCP_CLIENT_REQUEST_BODY_LIMIT_BYTES=33554432
LCE_MCP_REQUEST_BODY_LIMIT_BYTES=4194304
MCP_CALL_TIMEOUT=120s
INDEX_MCP_CALL_TIMEOUT=330s
MCP_INIT_SESSION_TIMEOUT=10s
PLATFORM_MODEL_CONFIG_BODY_LIMIT_BYTES=65536
PLATFORM_MODEL_CONFIG_READ_TIMEOUT=15s
PLATFORM_MODEL_DISCOVERY_TIMEOUT=30s
PLATFORM_MODEL_CONFIG_VALIDATION_TIMEOUT=35s
PLATFORM_MODEL_CONFIG_BARRIER_WAIT=10s
