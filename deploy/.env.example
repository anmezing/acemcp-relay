NEXT_PUBLIC_MINIMUM_LOADING_FEEDBACK_MS=300
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_MAX_PASSWORD_LENGTH=128
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=3600
AUTH_ORGANIZATION_INVITATION_TTL_SECONDS=172800
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
REDIS_URL=
LCE_RELAY_URL=http://relay:3009
LCE_RELAY_REQUEST_TIMEOUT_MS=15000
LCE_MODEL_CONFIG_SAVE_PROXY_TIMEOUT_MS=140000
LCE_MODEL_DISCOVERY_PROXY_TIMEOUT_MS=30000
LCE_PLATFORM_MODEL_CONFIG_BODY_LIMIT_BYTES=65536
LCE_PLATFORM_MODEL_CONFIG_RESPONSE_LIMIT_BYTES=65536
LCE_PROVIDER_MODEL_DISCOVERY_RESPONSE_LIMIT_BYTES=1048576
LCE_PACKAGE_REGISTRY_URL=https://registry.npmjs.org
LCE_CLIENT_VERSION_CACHE_SECONDS=900
LCE_MODEL_DISCOVERY_RESULT_LIMIT=500
LCE_ADMIN_LOG_PAGE_SIZE=50
PAYMENT_PROVIDER_REQUEST_TIMEOUT_MS=10000
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENT_ORDER_TTL_MINUTES=15
# Host tuning policy used by deploy/tune-host.sh. All values are optional;
# defaults are shown so operators can review them before changing the host.
DEPLOY_SYSCTL_CONFIG_PATH=/etc/sysctl.d/99-lce-performance.conf
DEPLOY_NGINX_MAIN_CONFIG=/etc/nginx/nginx.conf
DEPLOY_NGINX_SERVICE=nginx
DEPLOY_POSTGRES_OS_USER=postgres
DEPLOY_POSTGRES_SERVICE=postgresql
DEPLOY_SOMAXCONN=8192
DEPLOY_TCP_MAX_SYN_BACKLOG=8192
DEPLOY_IP_LOCAL_PORT_MIN=10240
DEPLOY_IP_LOCAL_PORT_MAX=65535
DEPLOY_TCP_FIN_TIMEOUT=30
DEPLOY_NF_CONNTRACK_MAX=524288
DEPLOY_NGINX_WORKER_RLIMIT_NOFILE=65535
DEPLOY_NGINX_WORKER_CONNECTIONS=8192
DEPLOY_POSTGRES_MAX_CONNECTIONS=160
DEPLOY_POSTGRES_RESERVED_CONNECTIONS=5

# Repository locations/refs used by deploy/deploy.sh. Leave locations empty to
# use its layout-relative defaults; override when repositories live elsewhere.
DEPLOY_LCE_DIR=
DEPLOY_RELAY_DIR=
DEPLOY_FRONTEND_DIR=
DEPLOY_REF_LCE=
DEPLOY_REF_RELAY=
DEPLOY_REF_FRONTEND=
DEPLOY_BRANCH_LCE=feat/multi-tenant-relay
DEPLOY_BRANCH_RELAY=main
DEPLOY_BRANCH_FRONTEND=main
DEPLOY_PRUNE_DOCKER_RESOURCES=true
DEPLOY_BUILD_CACHE_KEEP_STORAGE=5GB
DEPLOY_BUILD_CACHE_MAX_AGE=168h
DEPLOY_UNUSED_IMAGE_MAX_AGE=168h
