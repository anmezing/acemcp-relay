# ── PostgreSQL (host) ──
POSTGRES_USER=acemcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acemcp_relay

# ── LCE Embedding/Rerank Providers ──
EMBEDDINGS_PROVIDER=siliconflow
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDINGS_API_KEY=
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# ── Better Auth (frontend) ──
BETTER_AUTH_URL=https://513689.xyz
BETTER_AUTH_SECRET=change-me-random-string

# ── OAuth Providers ──
AUTH_LINUXDO_ID=
AUTH_LINUXDO_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365

# ── 租户断言（relay ↔ LCE，必填）──
# tenant_id 只是普通 MCP 工具入参，没有这个共享密钥，任何能连到 LCE 端口的人
# 都能读写、甚至清空任意租户的索引。relay 用它签发短时效断言，LCE 校验后才认
# tenant_id。两个服务必须配同一个值，长度 >=32；未设置时 docker compose up 会
# 直接失败（这是有意的，不是可选项）。
# 生成：openssl rand -base64 48
LCE_TENANT_ASSERTION_SECRET=

# ── 按用户模型配置（BYO 模型，可选）──
# 用户自带 embedding/rerank 的 API key 用它加密后入库（AES-256-GCM，
# 密钥 = SHA-256(此值)）。留空则整个 BYO 特性关闭（不查表、不注入）。
# 前端与 relay 必须配同一个值；改动会导致已存配置无法解密。
# 生成：openssl rand -base64 48
MODEL_CONFIG_SECRET=

# ── 管理控制台 ──
# 有权访问 /console 管理面板的邮箱，逗号分隔；留空表示没有管理员。
ADMIN_EMAILS=

# ── 配额 ──
# 每用户每日请求上限，0 = 不限。可在管理面板按用户覆盖。
DEFAULT_DAILY_REQUEST_LIMIT=0

# ── 设备绑定（防账号共用）──
# off = 不校验；log = 只记告警不拦截（灰度期默认，老客户端不受影响）；
# enforce = 未注册设备一律 401。
DEVICE_BINDING_MODE=log
# 每用户最大设备数；超出时淘汰最久未活跃的设备。1 = 单设备互踢。
MAX_DEVICES_PER_USER=1
# 同一设备在 DEVICE_IP_WINDOW 内出现超过 DEVICE_MAX_IPS 个来源 IP 时写告警。
DEVICE_MAX_IPS=3
DEVICE_IP_WINDOW=10m
DEVICE_CACHE_TTL=5m
API_KEY_CACHE_TTL=30m
