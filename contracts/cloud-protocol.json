{
  "$comment": "三仓库（lce / relay / 前端）共享云协议契约的单一源头。relay 与前端提交本文件的精确快照，独立 CI 直接读取快照且缺失即失败；修改本文件必须三仓同步。",
  "schemaVersion": "1.8",
  "cloudToolSurface": [
    "codebase-retrieval",
    "codebase_symbol_graph",
    "codebase_enhance_prompt",
    "codebase_index_status",
    "codebase_git_context",
    "codebase_review_changes"
  ],
  "codebaseIndex": {
    "operations": [
      "start",
      "upload",
      "status",
      "complete",
      "fail"
    ],
    "requiredFields": {
      "start": [
        "operation",
        "root_id",
        "files"
      ],
      "upload": [
        "operation",
        "job_id",
        "root_id",
        "files"
      ],
      "complete": [
        "operation",
        "job_id"
      ],
      "fail": [
        "operation",
        "job_id",
        "error"
      ]
    },
    "optionalFields": {
      "start": [
        "client_version",
        "branch",
        "revision"
      ]
    },
    "startOutcomes": {
      "created": {
        "requiredFields": [
          "job"
        ],
        "optionalFields": [
          "pending_files",
          "deleted_files"
        ],
        "providerWork": "allowed"
      },
      "unchanged": {
        "requiredFields": [
          "unchanged"
        ],
        "providerWork": "forbidden"
      },
      "busy": {
        "requiredFields": [
          "busy",
          "busy_reason",
          "retry_after_seconds"
        ],
        "optionalFields": [
          "active_job"
        ],
        "reasons": [
          "active_job",
          "rate_limited"
        ],
        "providerWork": "forbidden"
      },
      "busyRetryPolicy": "client_waits_without_consuming_failure_retry_budget"
    },
    "limitNegotiation": {
      "$comment": "Relay publishes the effective deployment limits on the codebase_index tool. Clients read them before scanning so deployment configuration and client batching cannot drift. Missing metadata is supported only for older relays through the compatibility fallback; malformed metadata fails before a manifest is sent.",
      "toolMetadataField": "_meta",
      "metadataKey": "com.anmezing.lce/index-limits",
      "requiredFields": [
        "maxFileBytes",
        "maxBatchFiles",
        "maxBatchBytes",
        "estimatedChunkBytes",
        "maxEstimatedChunks",
        "maxManifestFiles",
        "maxPathBytes"
      ],
      "missingMetadataBehavior": "use_compatibility_fallback",
      "invalidMetadataBehavior": "fail_before_manifest_scan"
    },
    "compatibilityFallbackLimits": {
      "maxFileBytes": 524288,
      "maxBatchFiles": 50,
      "maxBatchBytes": 524288,
      "estimatedChunkBytes": 4096,
      "maxEstimatedChunks": 128,
      "maxManifestFiles": 100000,
      "maxPathBytes": 4096
    }
  },
  "rootResolution": {
    "$comment": "客户端解析项目根的唯一顺序。cwd 只在客户端不提供 roots 时作为兼容回退，且必须经过 Git 仓库、用户家目录和文件系统根校验。每个候选根必须是 git 仓库；否则拒绝并引导用户 git init，而不是退化成路径哈希 root 静默索引。",
    "order": [
      "--repo",
      "roots/list",
      "validated-cwd",
      "tool.repo_path",
      "refuse"
    ],
    "requiresGitRepository": true,
    "rejectsHomeDirAndFilesystemRoot": true,
    "multiRoot": "all_roots_indexed_one_view_each",
    "defaultQueryRoot": "primary",
    "dynamicToolRegistration": {
      "argument": "repo_path",
      "requiresAbsoluteGitRepository": true,
      "serializedAndDeduplicated": true,
      "mutuallyExclusiveWith": "root_id",
      "forwardedToRelay": false
    }
  },
  "indexReadiness": {
    "$comment": "检索类工具在索引未就绪时立即返回的结构化状态，不阻塞等待。ready 的充要条件是该视图完成过一次 start -> upload -> complete。failureClass=permanent 表示重试无用（如 manifest 超限、根非 git 仓库、鉴权拒绝），transient 表示可退避重试。",
    "phases": [
      "resolving_roots",
      "not_started",
      "scanning",
      "uploading",
      "publishing",
      "ready",
      "failed"
    ],
    "readyRequiresCompletedPublish": true,
    "failureClasses": [
      "permanent",
      "transient"
    ],
    "errorCodes": [
      "INDEX_NOT_READY",
      "INDEX_FAILED",
      "ROOT_NOT_RESOLVED",
      "ROOT_NOT_A_GIT_REPO"
    ],
    "statusFields": [
      "root_id",
      "phase",
      "index_available",
      "published_revision",
      "branch",
      "revision",
      "indexed_files",
      "total_files",
      "failure_class",
      "message",
      "remediation",
      "available_roots"
    ]
  },
  "responseEnvelope": {
    "schemaVersion": "1.0",
    "required": [
      "ok"
    ],
    "onSuccess": [
      "payload"
    ],
    "onError": [
      "error"
    ],
    "errorShape": [
      "message"
    ]
  },
  "manifestEntryFields": [
    "path",
    "hash",
    "size",
    "estimated_chunks"
  ],
  "clientRequestHeaders": [
    "Authorization",
    "X-LCE-Client-Version"
  ],
  "clientCompatibility": {
    "$comment": "当前发布版本以 npm dist-tag latest 为唯一可信来源；管理员只维护最低允许版本。配置最低版本后，索引请求必须携带客户端版本且不得低于下限。",
    "package": "@anmezing/lce-cloud",
    "latestVersionSource": "npm_dist_tag_latest",
    "minimumVersionSource": "relay_persistent_runtime_policy_with_env_bootstrap",
    "minimumVersionAdminConfigurable": true,
    "indexStartRequiresClientVersionWhenMinimumConfigured": true,
    "restartRequiredAfterUpgrade": true,
    "upgradeMechanism": "runtime_or_client_package_manager"
  },
  "codebaseRetrieval": {
    "$comment": "codebase-retrieval 经 relay 的可选透传参数。root_id 把检索限定到单个索引根（缺省=全租户，向后兼容）；客户端默认自动注入当前分支视图的 root_id。",
    "optionalArguments": [
      "root_id"
    ],
    "clientOnlyArguments": [
      "repo_path"
    ],
    "localKnowledgeFusion": {
      "$comment": "The local client may add bounded repository-local evidence after Relay retrieval. This does not add Relay arguments and does not upload artifacts.",
      "client": "@anmezing/lce-cloud",
      "mode": "post_retrieval_local",
      "defaultArtifacts": {
        "graphify": "graphify-out/graph.json",
        "okf": ".okf"
      },
      "responseField": "payload.localKnowledge",
      "textSection": "Local Graphify/OKF evidence",
      "uploadsArtifacts": false,
      "artifactIndexingPolicy": "default_and_custom_artifact_roots_hard_excluded_from_manifest_and_watch_even_if_gitignore_negates",
      "uploadAuthorization": "relay_pending_files_must_be_unique_exact_members_of_the_current_client_manifest",
      "sourcePathPolicy": "repo_sources_must_pass_repository_boundary_gitignore_and_allowed_extension_checks",
      "rootBinding": "local_evidence_is_fused_only_when_requested_root_id_exactly_matches_current_local_view_root_id",
      "lineSemantics": {
        "graphify": "line_range_only_when_in_bounds_and_declared_line_contains_symbol",
        "okf": "line_range_means_repository_source_range_is_in_bounds_not_semantically_proven"
      },
      "missingArtifactBehavior": "response_unchanged",
      "malformedArtifactBehavior": "supplemental_diagnostic_without_retrieval_failure"
    }
  },
  "promptEnhancement": {
    "$comment": "Relay removes tenant_id from the public schema and injects the authenticated tenant. The local client defaults root_id to the current published branch view. Paths and line ranges in results are derived from retrieved chunks, not generation output.",
    "toolName": "codebase_enhance_prompt",
    "input": {
      "requiredFields": [
        "prompt"
      ],
      "optionalFields": [
        "technical_terms",
        "root_id",
        "output_language",
        "response_format"
      ],
      "clientOnlyFields": [
        "repo_path"
      ],
      "relayInjectedFields": [
        "tenant_id"
      ],
      "defaults": {
        "output_language": "auto",
        "response_format": "text"
      }
    },
    "verifiedReferenceFields": [
      "rootId",
      "path",
      "startLine",
      "endLine",
      "breadcrumb"
    ],
    "jsonEnvelope": {
      "schemaVersion": "1.0",
      "requiredFields": [
        "schemaVersion",
        "toolName",
        "ok",
        "tool",
        "responseFormat"
      ],
      "successFields": [
        "payload.originalPrompt",
        "payload.enhancedPrompt",
        "payload.references",
        "payload.warnings",
        "payload.retrieval"
      ],
      "errorFields": [
        "error.message",
        "error.code"
      ],
      "errorCodes": [
        "PROMPT_ENHANCER_NOT_CONFIGURED",
        "INVALID_ARGUMENTS",
        "TENANT_ACCESS_DENIED"
      ]
    },
    "costs": {
      "readOnly": true,
      "providerCalls": {
        "embedding": "required",
        "rerank": "when configured",
        "generation": "required"
      },
      "writesIndex": false
    }
  },
  "rootViews": {
    "$comment": "分支视图编码为 root_id = <base_root_id>@<view_branch>。'@' 只允许非首位；分支 token 字符集为 [A-Za-z0-9._-]，清洗会改变原名时追加 8 位哈希后缀以避免碰撞；root_id 总长 ≤ maxRootIdLength（relay maxIndexRootIDLen）。无 '@' 的 root_id 即 default 视图。/mcp/roots 按最后一个 '@' 派生 base_root_id 与 view_branch。",
    "separator": "@",
    "defaultView": "default",
    "maxRootIdLength": 128,
    "rootsDerivedFields": [
      "base_root_id",
      "view_branch"
    ]
  }
}
