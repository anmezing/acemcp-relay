{
  "$comment": "三仓库（lce / relay / 前端）共享云协议契约的单一源头。relay 与前端提交本文件的精确快照，独立 CI 直接读取快照且缺失即失败；修改本文件必须三仓同步。",
  "schemaVersion": "1.9",
  "cloudToolSurface": [
    "codebase-retrieval",
    "codebase_symbol_graph",
    "codebase_deep_graph",
    "codebase_graph_algorithm",
    "codebase_enhance_prompt",
    "codebase_index_status",
    "codebase_git_context",
    "codebase_review_changes"
  ],
  "codebaseIndex": {
    "operations": [
      "start",
      "upload",
      "status",
      "complete",
      "fail"
    ],
    "requiredFields": {
      "start": [
        "operation",
        "root_id",
        "files"
      ],
      "upload": [
        "operation",
        "job_id",
        "root_id",
        "files"
      ],
      "complete": [
        "operation",
        "job_id"
      ],
      "fail": [
        "operation",
        "job_id",
        "error"
      ]
    },
    "optionalFields": {
      "start": [
        "client_version",
        "branch",
        "revision"
      ],
      "fail": [
        "error_code",
        "error_origin",
        "recovery"
      ]
    },
    "failureDiagnostics": {
      "$comment": "Clients may report a stable failure diagnostic with fail. The three fields are atomic and Relay validates the exact code/origin/recovery tuple before persisting it. Older clients may omit all three; Relay then classifies the legacy error text once and persists the result.",
      "fields": [
        "error_code",
        "error_origin",
        "recovery"
      ],
      "presenceRule": "all_or_none",
      "invalidValueBehavior": "reject",
      "missingFieldsBehavior": "relay_classifies_error_text_and_persists_result",
      "codes": {
        "client_disconnected": {
          "origin": "client",
          "recovery": "restart_client"
        },
        "heartbeat_timeout": {
          "origin": "relay",
          "recovery": "restart_client"
        },
        "embedding_space_changed": {
          "origin": "remote_index",
          "recovery": "reset_root"
        },
        "upstream_bad_gateway": {
          "origin": "remote_index",
          "recovery": "retry_after_service_recovers"
        },
        "provider_billing": {
          "origin": "provider",
          "recovery": "fix_provider_billing"
        },
        "provider_rate_limited": {
          "origin": "provider",
          "recovery": "retry_later"
        },
        "provider_invalid_request": {
          "origin": "provider",
          "recovery": "contact_admin"
        },
        "repository_file_limit": {
          "origin": "client",
          "recovery": "reduce_repository"
        },
        "repository_file_size_limit": {
          "origin": "client",
          "recovery": "reduce_repository"
        },
        "index_quota_exceeded": {
          "origin": "relay",
          "recovery": "wait_for_quota_reset"
        },
        "provider_authentication": {
          "origin": "provider",
          "recovery": "fix_credentials"
        },
        "network_unavailable": {
          "origin": "network",
          "recovery": "restart_client"
        },
        "index_failed": {
          "origin": "unknown",
          "recovery": "contact_admin"
        }
      }
    },
    "startOutcomes": {
      "created": {
        "requiredFields": [
          "job"
        ],
        "optionalFields": [
          "pending_files",
          "deleted_files"
        ],
        "providerWork": "allowed"
      },
      "unchanged": {
        "requiredFields": [
          "unchanged"
        ],
        "providerWork": "forbidden"
      },
      "busy": {
        "requiredFields": [
          "busy",
          "busy_reason",
          "retry_after_seconds"
        ],
        "optionalFields": [
          "active_job"
        ],
        "reasons": [
          "active_job",
          "rate_limited"
        ],
        "providerWork": "forbidden"
      },
      "busyRetryPolicy": "client_waits_without_consuming_failure_retry_budget"
    },
    "limitNegotiation": {
      "$comment": "Relay publishes the effective deployment limits on the codebase_index tool. Clients read them before scanning so deployment configuration and client batching cannot drift. Missing metadata is supported only for older relays through the compatibility fallback; malformed metadata fails before a manifest is sent.",
      "toolMetadataField": "_meta",
      "metadataKey": "com.anmezing.lce/index-limits",
      "requiredFields": [
        "maxFileBytes",
        "maxBatchFiles",
        "maxBatchBytes",
        "estimatedChunkBytes",
        "maxEstimatedChunks",
        "maxManifestFiles",
        "maxPathBytes"
      ],
      "missingMetadataBehavior": "use_compatibility_fallback",
      "invalidMetadataBehavior": "fail_before_manifest_scan"
    },
    "compatibilityFallbackLimits": {
      "maxFileBytes": 524288,
      "maxBatchFiles": 50,
      "maxBatchBytes": 524288,
      "estimatedChunkBytes": 4096,
      "maxEstimatedChunks": 128,
      "maxManifestFiles": 100000,
      "maxPathBytes": 4096
    }
  },
  "rootResolution": {
    "$comment": "客户端解析项目根的唯一顺序。cwd 只在客户端不提供 roots 时作为兼容回退，且必须经过 Git 仓库、用户家目录和文件系统根校验。每个候选根必须是 git 仓库；否则拒绝并引导用户 git init，而不是退化成路径哈希 root 静默索引。",
    "order": [
      "--repo",
      "roots/list",
      "validated-cwd",
      "tool.repo_path",
      "refuse"
    ],
    "requiresGitRepository": true,
    "rejectsHomeDirAndFilesystemRoot": true,
    "multiRoot": "all_roots_indexed_one_view_each",
    "defaultQueryRoot": "primary",
    "dynamicToolRegistration": {
      "argument": "repo_path",
      "requiresAbsoluteGitRepository": true,
      "serializedAndDeduplicated": true,
      "rootIdValidation": {
        "whenBothProvided": "resolve_repo_path_then_compare_view_root_id",
        "onMatch": "continue_and_forward_root_id",
        "onMismatch": "reject_with_ROOT_NOT_RESOLVED"
      },
      "forwardedToRelay": false
    }
  },
  "indexReadiness": {
    "$comment": "检索类工具在索引未就绪时立即返回的结构化状态，不阻塞等待。ready 的充要条件是该视图完成过一次 start -> upload -> complete。failureClass=permanent 表示重试无用（如 manifest 超限、根非 git 仓库、鉴权拒绝），transient 表示可退避重试。",
    "phases": [
      "resolving_roots",
      "not_started",
      "scanning",
      "uploading",
      "publishing",
      "ready",
      "failed"
    ],
    "readyRequiresCompletedPublish": true,
    "failureClasses": [
      "permanent",
      "transient"
    ],
    "errorCodes": [
      "INDEX_NOT_READY",
      "INDEX_FAILED",
      "ROOT_NOT_RESOLVED",
      "ROOT_NOT_A_GIT_REPO"
    ],
    "statusFields": [
      "root_id",
      "phase",
      "index_available",
      "published_revision",
      "branch",
      "revision",
      "indexed_files",
      "total_files",
      "failure_class",
      "message",
      "remediation",
      "available_roots"
    ]
  },
  "responseEnvelope": {
    "schemaVersion": "1.0",
    "required": [
      "ok"
    ],
    "onSuccess": [
      "payload"
    ],
    "onError": [
      "error"
    ],
    "errorShape": [
      "message"
    ],
    "optionalErrorShape": [
      "code",
      "retry_after_seconds"
    ]
  },
  "manifestEntryFields": [
    "path",
    "hash",
    "size",
    "estimated_chunks"
  ],
  "clientRequestHeaders": [
    "Authorization",
    "X-LCE-Client-Version"
  ],
  "clientCompatibility": {
    "$comment": "当前发布版本以 npm dist-tag latest 为唯一可信来源；管理员只维护最低允许版本。配置最低版本后，索引请求必须携带客户端版本且不得低于下限。",
    "package": "@anmezing/lce-cloud",
    "latestVersionSource": "npm_dist_tag_latest",
    "minimumVersionSource": "relay_persistent_runtime_policy_with_env_bootstrap",
    "minimumVersionAdminConfigurable": true,
    "indexStartRequiresClientVersionWhenMinimumConfigured": true,
    "restartRequiredAfterUpgrade": true,
    "upgradeMechanism": "runtime_or_client_package_manager"
  },
  "codebaseRetrieval": {
    "$comment": "codebase-retrieval 经 relay 的可选透传参数。root_id 把检索限定到单个索引根（缺省=全租户，向后兼容）；客户端默认自动注入当前分支视图的 root_id。",
    "optionalArguments": [
      "root_id"
    ],
    "clientOnlyArguments": [
      "repo_path"
    ],
    "localKnowledgeFusion": {
      "$comment": "The local client may add bounded repository-local evidence after Relay retrieval. This does not add Relay arguments and does not upload artifacts.",
      "client": "@anmezing/lce-cloud",
      "mode": "post_retrieval_local",
      "defaultArtifacts": {
        "graphify": "graphify-out/graph.json",
        "okf": ".okf"
      },
      "responseField": "payload.localKnowledge",
      "textSection": "Local Graphify/OKF evidence",
      "uploadsArtifacts": false,
      "artifactIndexingPolicy": "default_and_custom_artifact_roots_hard_excluded_from_manifest_and_watch_even_if_gitignore_negates",
      "uploadAuthorization": "relay_pending_files_must_be_unique_exact_members_of_the_current_client_manifest",
      "sourcePathPolicy": "repo_sources_must_pass_repository_boundary_gitignore_and_allowed_extension_checks",
      "rootBinding": "local_evidence_is_fused_only_when_requested_root_id_exactly_matches_current_local_view_root_id",
      "lineSemantics": {
        "graphify": "line_range_only_when_in_bounds_and_declared_line_contains_symbol",
        "okf": "line_range_means_repository_source_range_is_in_bounds_not_semantically_proven"
      },
      "missingArtifactBehavior": "response_unchanged",
      "malformedArtifactBehavior": "supplemental_diagnostic_without_retrieval_failure"
    }
  },
  "promptEnhancement": {
    "$comment": "Relay removes tenant_id from the public schema and injects the authenticated tenant. The local client defaults root_id to the current published branch view. Paths and line ranges in results are derived from retrieved chunks, not generation output.",
    "toolName": "codebase_enhance_prompt",
    "input": {
      "requiredFields": [
        "prompt"
      ],
      "optionalFields": [
        "technical_terms",
        "root_id",
        "output_language",
        "response_format"
      ],
      "clientOnlyFields": [
        "repo_path"
      ],
      "relayInjectedFields": [
        "tenant_id"
      ],
      "defaults": {
        "output_language": "auto",
        "response_format": "text"
      }
    },
    "verifiedReferenceFields": [
      "rootId",
      "path",
      "startLine",
      "endLine",
      "breadcrumb"
    ],
    "jsonEnvelope": {
      "schemaVersion": "1.0",
      "requiredFields": [
        "schemaVersion",
        "toolName",
        "ok",
        "tool",
        "responseFormat"
      ],
      "successFields": [
        "payload.originalPrompt",
        "payload.enhancedPrompt",
        "payload.references",
        "payload.warnings",
        "payload.retrieval"
      ],
      "errorFields": [
        "error.message",
        "error.code"
      ],
      "errorCodes": [
        "PROMPT_ENHANCER_NOT_CONFIGURED",
        "INVALID_ARGUMENTS",
        "TENANT_ACCESS_DENIED"
      ]
    },
    "costs": {
      "readOnly": true,
      "providerCalls": {
        "embedding": "required",
        "rerank": "when configured",
        "generation": "required"
      },
      "writesIndex": false
    }
  },
  "deepGraph": {
    "$comment": "Root-scoped online deep graph reads use the Neo4j derived projection. tenant_id is injected by Relay; clients select root_id through the current branch view. Global cross-root/repository graph algorithms require a later asynchronous global generation manifest.",
    "toolName": "codebase_deep_graph",
    "input": {
      "requiredFields": ["symbol"],
      "relayRequiredFields": ["root_id", "symbol"],
      "optionalFields": [
        "root_id",
        "target_symbol",
        "query_type",
        "direction",
        "depth",
        "limit",
        "max_nodes",
        "max_edges",
        "max_paths",
        "relationship_types",
        "required_revision",
        "allow_stale",
        "include_evidence",
        "response_format"
      ],
      "relayInjectedFields": ["tenant_id"],
      "defaults": {
        "query_type": "impact",
        "direction": "outgoing",
        "depth": 6,
        "limit": 100,
        "max_nodes": 1000,
        "max_edges": 5000,
        "max_paths": 20,
        "relationship_types": ["CALLS", "TYPE_USES", "IMPORTS", "REFERENCES", "DECLARES"],
        "allow_stale": false,
        "include_evidence": false,
        "response_format": "text"
      }
    },
    "scope": "tenant_root",
    "freshness": "The handler compares the PostgreSQL projection checkpoint with the active Neo4j generation. Lagging projections fail closed unless allow_stale=true, in which case freshness is marked stale.",
    "onlineBudgets": {
      "maxDepth": 64,
      "maxNodes": 10000,
      "maxEdges": 50000,
      "maxPaths": 100
    },
    "queryTypes": ["impact", "paths", "cycles", "scc", "centrality", "global_dependencies"],
    "globalDependencies": "GRAPH_GLOBAL_SCOPE_UNAVAILABLE until a tenant generation manifest and asynchronous global graph jobs are implemented",
    "jsonEnvelope": {
      "schemaVersion": "1.0",
      "requiredFields": ["schemaVersion", "toolName", "ok", "tool", "responseFormat"],
      "successFields": ["payload"],
      "errorFields": ["error.message", "error.code"],
      "errorCodes": [
        "GRAPH_QUERY_INVALID",
        "GRAPH_ROOT_REQUIRED",
        "GRAPH_PROJECTION_NOT_FOUND",
        "GRAPH_PROJECTION_LAGGING",
        "GRAPH_SYMBOL_NOT_FOUND",
        "GRAPH_TARGET_NOT_FOUND",
        "GRAPH_GLOBAL_SCOPE_UNAVAILABLE",
        "NEO4J_UNAVAILABLE",
        "INVALID_ARGUMENTS"
      ]
    },
    "costs": {
      "readOnly": true,
      "callsEmbeddingProvider": false,
      "callsRerankProvider": false,
      "callsExternalApis": false,
      "writesIndex": false
    }
  },
  "graphAlgorithms": {
    "$comment": "Graph algorithms are an asynchronous, tenant-root-generation-scoped contract. The control plane persists jobs and exposes worker lease primitives; an optional Neo4j GDS worker becomes available only after a successful capability probe and a fresh heartbeat. There is no synchronous MCP fallback.",
    "toolName": "codebase_graph_algorithm",
    "operations": ["submit", "status"],
    "input": {
      "requiredFields": [],
      "conditionalRequiredFields": {
        "submit": ["root_id", "algorithm"],
        "status": ["job_id"]
      },
      "optionalFields": [
        "operation",
        "root_id",
        "job_id",
        "algorithm",
        "parameters",
        "result_ttl_seconds",
        "response_format"
      ],
      "relayInjectedFields": ["tenant_id"],
      "defaults": {
        "operation": "submit",
        "parameters": {},
        "result_ttl_seconds": 3600,
        "response_format": "text"
      }
    },
    "algorithms": ["scc", "centrality"],
    "scope": "tenant_root_generation",
    "jobIdentity": ["tenant_id", "root_id", "generation", "algorithm", "parameters_hash"],
    "freshness": "A submission requires a ready Neo4j checkpoint and pins the active generation, epoch, and PostgreSQL revision; a later projection generation creates a distinct job identity.",
    "executor": {
      "available": false,
      "mode": "control_plane_only",
      "healthyMode": "async_worker",
      "availability": "recent_worker_heartbeat",
      "synchronousExecution": false,
      "globalGraphExecution": false
    },
    "budgets": {
      "maxParameterBytes": 16384,
      "maxResultBytes": 4194304,
      "minResultTtlSeconds": 60,
      "maxResultTtlSeconds": 604800
    },
    "resultBounds": {
      "scc": {
        "componentsTruncatedField": "summary.componentsTruncated",
        "membersTruncatedField": "components[].membersTruncated"
      }
    },
    "jobFields": [
      "jobId",
      "tenantId",
      "rootId",
      "generation",
      "epochId",
      "revision",
      "algorithm",
      "parameters",
      "resultTtlMs",
      "parametersHash",
      "state",
      "attemptCount",
      "leaseOwner",
      "leaseExpiresAt",
      "lastError",
      "createdAt",
      "updatedAt",
      "completedAt",
      "result",
      "resultExpiresAt"
    ],
    "lifecycle": ["pending", "leased", "completed", "dead"],
    "workerGuarantees": [
      "FOR_UPDATE_SKIP_LOCKED_claim",
      "lease_owner_and_expiry_fencing",
      "bounded_retry_and_dead_letter_state",
      "generation_bound_result_cache",
      "bounded_result_and_error_storage",
      "bounded_expiry_and_terminal_job_purge",
      "gds_capability_probe_before_claim",
      "fresh_worker_heartbeat",
      "budget_check_before_projection",
      "bounded_gds_projection_cleanup",
      "bounded_scc_member_preview"
    ],
    "jsonEnvelope": {
      "schemaVersion": "1.0",
      "requiredFields": ["schemaVersion", "operation", "executor", "cacheHit", "job"],
      "successFields": ["job"],
      "errorFields": ["error.message", "error.code"],
      "errorCodes": [
        "GRAPH_ALGORITHM_GRAPH_NOT_READY",
        "GRAPH_ALGORITHM_INVALID_ARGUMENTS",
        "GRAPH_ALGORITHM_INVALID_PARAMETERS",
        "GRAPH_ALGORITHM_INPUT_TOO_LARGE",
        "GRAPH_ALGORITHM_JOB_NOT_FOUND",
        "GRAPH_ALGORITHM_LEASE_LOST",
        "GRAPH_ALGORITHM_QUERY_FAILED",
        "GRAPH_ALGORITHM_BUDGET_EXCEEDED",
        "GRAPH_ALGORITHM_PROJECTION_MISMATCH",
        "GRAPH_ALGORITHM_EXECUTOR_UNAVAILABLE",
        "GRAPH_ALGORITHM_CLEANUP_FAILED",
        "INVALID_ARGUMENTS"
      ]
    },
    "costs": {
      "onlineGraphTraversal": false,
      "providerCalls": false,
      "writesControlPlane": true,
      "writesIndex": false
    }
  },
  "rootViews": {
    "$comment": "分支视图编码为 root_id = <base_root_id>@<view_branch>。'@' 只允许非首位；分支 token 字符集为 [A-Za-z0-9._-]，清洗会改变原名时追加 8 位哈希后缀以避免碰撞；root_id 总长 ≤ maxRootIdLength（relay maxIndexRootIDLen）。无 '@' 的 root_id 即 default 视图。/mcp/roots 按最后一个 '@' 派生 base_root_id 与 view_branch。",
    "separator": "@",
    "defaultView": "default",
    "maxRootIdLength": 128,
    "rootsDerivedFields": [
      "base_root_id",
      "view_branch"
    ]
  }
}
