# Server Configuration
SERVER_ADDR=127.0.0.1:3009
# Internal diagnostics listener (pprof + optional metrics). Keep loopback unless intentionally exposed.
PPROF_ADDR=127.0.0.1:6060

# Comma-separated reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep empty when clients connect directly.
TRUSTED_PROXIES=

# LCE MCP Configuration
# Streamable HTTP endpoint of the LCE MCP server
LCE_MCP_URL=http://127.0.0.1:3000/mcp

# Debug Capture (optional)
# Comma-separated path list. Prints request/response body previews to log.
# Temporary troubleshooting only; may contain code or user input — clear when done.
# Example: /mcp
DEBUG_CAPTURE_PATHS=
DEBUG_CAPTURE_MAX_BYTES=4096

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=postgres

# Redis Configuration
REDIS_PORT=6379

# Positive/negative account-ban lookup cache lifetime.
BANNED_CACHE_TTL=5m

# Trusted frontend-to-relay management requests. Use the same value as the
# frontend BETTER_AUTH_SECRET. deploy/docker-compose.yml wires this automatically.
CONSOLE_API_SECRET=your-secret-key-here

# Runtime policy (positive integers/durations; invalid values fall back to defaults)
INDEX_JOB_HEARTBEAT_TIMEOUT=10m
INDEX_JOB_SWEEP_INTERVAL=1m
INDEX_JOB_RENEW_TIMEOUT=15s
INDEX_MAX_MANIFEST_FILES=100000
INDEX_MAX_BATCH_FILES=50
INDEX_MAX_FILE_BYTES=524288
INDEX_MAX_BATCH_BYTES=524288
INDEX_MAX_PATH_BYTES=4096
INDEX_MAX_FAILURE_BYTES=2000
INDEX_START_MIN_INTERVAL=30s
INDEX_START_MEMORY_ENTRIES=4096
MCP_CLIENT_REQUEST_BODY_LIMIT_BYTES=33554432
LCE_MCP_REQUEST_BODY_LIMIT_BYTES=4194304
MCP_CALL_TIMEOUT=120s
INDEX_MCP_CALL_TIMEOUT=330s
MCP_INIT_SESSION_TIMEOUT=10s
PLATFORM_MODEL_CONFIG_BODY_LIMIT_BYTES=65536
PLATFORM_MODEL_CONFIG_READ_TIMEOUT=15s
PLATFORM_MODEL_DISCOVERY_TIMEOUT=30s
PLATFORM_MODEL_CONFIG_VALIDATION_TIMEOUT=35s
PLATFORM_MODEL_CONFIG_BARRIER_WAIT=10s
PLATFORM_MODEL_CONFIG_CLEAR_TIMEOUT=30s
PLATFORM_MODEL_CONFIG_SAVE_TIMEOUT=15s
PLATFORM_MODEL_CONFIG_RESET_SAVE_TIMEOUT=60s
PLATFORM_MODEL_CONFIG_LOCK_POLL_INTERVAL=50ms

# LCE cloud-service runtime policy used by deploy/docker-compose.yml
LCE_PLATFORM_MODEL_CONFIG_VALIDATION_TIMEOUT_MS=30000
LCE_PLATFORM_MODEL_CONFIG_LOCK_TIMEOUT_MS=10000
LCE_PLATFORM_MODEL_CONFIG_STATEMENT_TIMEOUT_MS=50000
LCE_PLATFORM_MODEL_VALIDATION_TICKET_TTL_MS=600000
LCE_PLATFORM_MODEL_PROVIDER_RESPONSE_MAX_BYTES=1048576
LCE_PLATFORM_MODEL_DISCOVERY_TIMEOUT_MS=10000
LCE_PLATFORM_MODEL_DISCOVERY_RESULT_LIMIT=500
LCE_CLOUD_INDEX_JOB_TTL_MINUTES=15
LCE_CLOUD_COMPILER_SNAPSHOT_MAX_FILES=2000
LCE_CLOUD_QUERY_EMBEDDING_CACHE_TTL_MS=30000
LCE_CLOUD_QUERY_EMBEDDING_CACHE_MAX_ENTRIES=512
LCE_CLOUD_RERANK_CACHE_TTL_MS=30000
LCE_CLOUD_RERANK_CACHE_MAX_ENTRIES=512


# Provider failure, retry, cooldown, response and cache policy
LCE_PROVIDER_AUTH_COOLDOWN_MS=300000
LCE_PROVIDER_BILLING_COOLDOWN_MS=900000
LCE_PROVIDER_TRANSIENT_COOLDOWN_MS=5000
LCE_PROVIDER_RATE_LIMIT_MIN_COOLDOWN_MS=1000
EMBEDDINGS_NETWORK_MAX_RETRIES=3
EMBEDDINGS_RATE_LIMIT_MAX_RETRIES=5
EMBEDDINGS_RETRY_INITIAL_DELAY_MS=1000
EMBEDDINGS_RATE_LIMIT_MIN_BACKOFF_MS=5000
EMBEDDINGS_RATE_LIMIT_MAX_BACKOFF_MS=60000
EMBEDDINGS_RATE_LIMIT_SUCCESS_INCREASE_COUNT=3
EMBEDDINGS_RATE_LIMIT_BACKOFF_DECAY_SUCCESSES=10
EMBEDDINGS_RATE_LIMIT_SLOT_POLL_MS=50
RERANK_MAX_ATTEMPTS=3
RERANK_RETRY_MAX_DELAY_MS=10000
RERANK_RATE_LIMIT_RETRY_BASE_MS=1000
RERANK_TRANSIENT_RETRY_BASE_MS=500
QUERY_REWRITE_MAX_QUERIES=3
QUERY_REWRITE_TIMEOUT_MS=4000
QUERY_REWRITE_CACHE_MAX_ENTRIES=256
PROMPT_ENHANCER_TIMEOUT_MS=30000
PROMPT_ENHANCER_MAX_CONCURRENT_REQUESTS=4
PROMPT_ENHANCER_MAX_RESPONSE_BYTES=524288
PROMPT_ENHANCER_MAX_OUTPUT_TOKENS=1200
PROMPT_ENHANCER_MAX_ATTEMPTS_PER_KEY=2
PROMPT_ENHANCER_RETRY_MIN_DELAY_MS=250
PROMPT_ENHANCER_RETRY_DEFAULT_DELAY_MS=500
PROMPT_ENHANCER_RETRY_MAX_DELAY_MS=2000

# Frontend server-side proxy and payload policy
LCE_RELAY_REQUEST_TIMEOUT_MS=15000
LCE_MODEL_CONFIG_SAVE_PROXY_TIMEOUT_MS=140000
LCE_MODEL_DISCOVERY_PROXY_TIMEOUT_MS=30000
LCE_PLATFORM_MODEL_CONFIG_BODY_LIMIT_BYTES=65536
LCE_PLATFORM_MODEL_CONFIG_RESPONSE_LIMIT_BYTES=65536
LCE_PROVIDER_MODEL_DISCOVERY_RESPONSE_LIMIT_BYTES=1048576


# Frontend auth, mail, storage and payment policy
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_MAX_PASSWORD_LENGTH=128
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=3600
AUTH_ORGANIZATION_INVITATION_TTL_SECONDS=172800
AUTH_GITHUB_MIN_ACCOUNT_AGE_DAYS=365
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
REDIS_URL=
PAYMENT_PROVIDER_REQUEST_TIMEOUT_MS=10000
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENT_ORDER_TTL_MINUTES=15

# Scheduler, connection-pool, cache, lease and cleanup policy
LEADERBOARD_UPDATE_INTERVAL=30m
LEADERBOARD_TOP_N=10
LEADERBOARD_TIMEZONE=Asia/Shanghai
HEALTH_CHECK_INTERVAL=2m
HEALTH_CHECK_TIMEOUT=30s
MCP_HTTP_IDLE_CONN_TIMEOUT=90s
MCP_HTTP_MAX_IDLE_CONNS=50
MCP_HTTP_MAX_IDLE_CONNS_PER_HOST=50
MCP_SESSION_TTL=30m
MCP_SESSION_SWEEP_INTERVAL=1m
MCP_TOOLS_CACHE_TTL=5m
MCP_MAX_SESSIONS=1000
MCP_MAX_SESSIONS_PER_USER=16
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=40
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
AUTH_CACHE_POSITIVE_TTL=30s
AUTH_CACHE_NEGATIVE_TTL=5s
AUTH_CACHE_MAX_ENTRIES=10000
MODEL_CONFIG_CACHE_TTL=5m
QUOTA_CACHE_TTL=5m
QUOTA_COUNTER_TTL=48h
REQUEST_LOG_STALE_AFTER=15m
REQUEST_LOG_RECONCILE_INTERVAL=5m
CLEAR_INDEX_COOLDOWN=72h
DELETE_ROOT_MIN_INTERVAL=1m
DELETE_ROOT_MEMORY_ENTRIES=4096
INDEX_OPERATION_LEASE_DURATION=2m
INDEX_OPERATION_RENEW_INTERVAL=30s
INDEX_OPERATION_ACQUIRE_POLL_INTERVAL=100ms
INDEX_OPERATION_DB_TIMEOUT=5s
